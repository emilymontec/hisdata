# HISDATA — variables de entorno de ejemplo
# Copiar como .env y completar con valores reales. NUNCA versionar el archivo .env real.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (ver infrastructure/containers/docker-compose.yml para desarrollo local)
DATABASE_URL=postgresql://hisdata:hisdata_dev_password@localhost:5432/hisdata?schema=public

# Secretos JWT — generar valores aleatorios largos (ej: openssl rand -hex 64) por entorno.
JWT_ACCESS_SECRET=cambia-este-valor-por-un-secreto-aleatorio-largo
